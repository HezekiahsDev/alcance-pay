PORT=4500

# Postgres (docker-compose.yml)
POSTGRES_USER=alcance_pay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alcance_pay
POSTGRES_HOST_PORT=5439
DATABASE_URL="postgresql://alcance_pay:change-me@localhost:5439/alcance_pay?schema=public"

# The one Alcance Paystack account (live or test secret key)
PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYSTACK_BASE_URL=https://api.paystack.co

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts saved-card authorizations. Never change it once cards are saved.
CARD_ENCRYPTION_KEY=
