{
  "name": "alcance-pay",
  "version": "0.1.0",
  "description": "Alcance Technologies payment service: one Paystack account for every Alcance app",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node init && nest build",
    "start": "node init && nest start",
    "start:dev": "node init && nest start --watch",
    "start:prod": "node init && node dist/main",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "apps": "ts-node --transpile-only scripts/apps.ts",
    "deploy": "bash scripts/deploy.sh",
    "ship": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^8.2.0",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
